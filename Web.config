<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="OlyMathDb" connectionString="Data Source=|DataDirectory|\OlyMath.db;Version=3;" providerName="System.Data.SQLite" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <authentication mode="Forms">
      <forms loginUrl="Login.aspx" timeout="2880" defaultUrl="Default.aspx" />
    </authentication>
    <pages>
      <namespaces>
        <add namespace="System.Web.Configuration"/>
      </namespaces>
    </pages>
  </system.web>
  <system.webServer>
    <defaultDocument>
      <files>
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>
</configuration>
