<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Dashboard.Master.cs" Inherits="OlyMath.Dashboard" %>
<%@ Import Namespace="Microsoft.AspNet.Identity" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OlyMath — <asp:ContentPlaceHolder ID="TitleContent" runat="server">Dashboard</asp:ContentPlaceHolder></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #F7F5F0;
            --white: #FFFFFF;
            --navy: #0D1B2A;
            --orange: #FF5733;
            --teal: #00C9A7;
            --slate: #8892A0;
            --border: #E2DDD6;
            --card-shadow: 0 2px 16px rgba(13,27,42,0.07);
            --radius: 14px;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--navy);
            min-height: 100vh;
            overflow-x: hidden;
        }

        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none;
            z-index: 9999;
            opacity: 0.4;
        }

        /* TOPNAV */
        .topnav {
            position: fixed;
            top: 0; left: 0; right: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            height: 64px;
            background: rgba(247,245,240,0.92);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
        }
        .topnav .logo {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 1.4rem;
            letter-spacing: -0.5px;
            color: var(--navy);
            text-decoration: none;
        }
        .topnav .logo span { color: var(--orange); }
        .topnav .nav-right { display: flex; align-items: center; gap: 10px; }

        .nav-badge {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.75rem;
            font-weight: 500;
            padding: 4px 12px;
            border-radius: 100px;
            background: var(--navy);
            color: var(--white);
            letter-spacing: 0.02em;
        }
        .nav-badge.trainer { background: var(--teal); color: var(--navy); }
        .nav-badge.admin   { background: var(--orange); color: var(--white); }

        .btn-logout {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.8rem;
            font-weight: 500;
            padding: 6px 16px;
            border-radius: 100px;
            border: 1.5px solid var(--border);
            background: transparent;
            color: var(--slate);
            cursor: pointer;
            text-decoration: none;
            transition: all 0.18s;
            display: inline-block;
        }
        .btn-logout:hover { border-color: var(--navy); color: var(--navy); }

        /* LAYOUT */
        .page-body {
            padding-top: 64px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .dashboard-layout {
            display: grid;
            grid-template-columns: 220px 1fr;
            min-height: calc(100vh - 64px);
        }

        /* SIDEBAR */
        .sidebar {
            background: var(--white);
            border-right: 1px solid var(--border);
            padding: 28px 0;
            position: sticky;
            top: 64px;
            height: calc(100vh - 64px);
            overflow-y: auto;
        }
        .sidebar-section { padding: 0 16px; margin-bottom: 4px; }
        .sidebar-label {
            font-size: 0.67rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--slate);
            padding: 8px 12px 6px;
            display: block;
        }
        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            font-size: 0.85rem;
            font-weight: 500;
            color: var(--slate);
            text-decoration: none;
            transition: all 0.15s;
            white-space: nowrap;
        }
        .sidebar-item:hover { background: var(--bg); color: var(--navy); }
        .sidebar-item.active { background: var(--navy); color: var(--white); }
        .sidebar-item .dot {
            width: 7px; height: 7px;
            border-radius: 50%;
            background: currentColor;
            opacity: 0.5;
            flex-shrink: 0;
        }
        .sidebar-item.active .dot { background: var(--orange); opacity: 1; }

        /* MAIN CONTENT */
        .main-content { padding: 40px 48px; overflow-y: auto; }

        /* SHARED COMPONENTS */
        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.9rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: var(--navy);
            margin-bottom: 6px;
        }
        .page-subtitle { font-size: 0.88rem; color: var(--slate); margin-bottom: 36px; font-weight: 300; }

        .stat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 16px; margin-bottom: 40px; }
        .stat-card {
            background: var(--white); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 24px 22px;
            transition: transform 0.18s, box-shadow 0.18s;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: var(--card-shadow); }
        .stat-val { font-family: 'Syne', sans-serif; font-size: 2.2rem; font-weight: 800; color: var(--navy); letter-spacing: -1px; line-height: 1; }
        .stat-label { font-size: 0.78rem; color: var(--slate); margin-top: 8px; }
        .stat-accent { color: var(--orange); }
        .stat-teal   { color: var(--teal); }

        .section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
        .section-title { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; color: var(--navy); }
        .section-link { font-size: 0.8rem; color: var(--orange); font-weight: 500; text-decoration: none; }
        .section-link:hover { text-decoration: underline; }

        .table-wrap { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; margin-bottom: 32px; }
        table { width: 100%; border-collapse: collapse; }
        thead { background: var(--bg); }
        thead th { padding: 12px 18px; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--slate); text-align: left; }
        tbody tr { border-top: 1px solid var(--border); transition: background 0.15s; }
        tbody tr:hover { background: var(--bg); }
        tbody td { padding: 13px 18px; font-size: 0.84rem; color: var(--navy); }

        .badge { display: inline-block; font-size: 0.7rem; font-weight: 600; padding: 3px 10px; border-radius: 100px; letter-spacing: 0.03em; }
        .badge.green  { background: #E6FBF7; color: #00A383; }
        .badge.orange { background: #FFF0EC; color: var(--orange); }
        .badge.grey   { background: var(--bg); color: var(--slate); }

        .list-item {
            display: flex; align-items: center; gap: 16px; padding: 16px 18px;
            background: var(--white); border: 1px solid var(--border); border-radius: var(--radius);
            margin-bottom: 10px; text-decoration: none; color: inherit;
            transition: all 0.18s;
        }
        .list-item:hover { border-color: var(--navy); transform: translateX(3px); }
        .list-item-icon {
            width: 38px; height: 38px; border-radius: 10px; background: var(--bg);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif; font-size: 0.8rem; font-weight: 800; color: var(--navy); flex-shrink: 0;
        }
        .list-item-icon.orange { background: #FFF0EC; color: var(--orange); }
        .list-item-icon.teal   { background: #E6FBF7; color: var(--teal); }
        .list-item-body { flex: 1; }
        .list-item-title { font-size: 0.88rem; font-weight: 500; color: var(--navy); }
        .list-item-sub   { font-size: 0.75rem; color: var(--slate); margin-top: 2px; }
        .list-item-badge { font-size: 0.7rem; font-weight: 600; padding: 4px 10px; border-radius: 100px; background: var(--bg); color: var(--slate); }
        .list-item-badge.active  { background: #E6FBF7; color: #00A383; }
        .list-item-badge.pending { background: #FFF0EC; color: var(--orange); }

        .content-card { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 28px 32px; margin-bottom: 20px; }
        .content-card h3 { font-family: 'Syne', sans-serif; font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 16px; }

        .btn-primary {
            font-family: 'DM Sans', sans-serif; font-size: 0.92rem; font-weight: 500;
            padding: 12px 28px; border-radius: 100px; border: none;
            background: var(--navy); color: var(--white); cursor: pointer;
            text-decoration: none; display: inline-block;
            transition: all 0.2s;
        }
        .btn-primary:hover { background: #1a2f45; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(13,27,42,0.18); }

        .btn-secondary {
            font-family: 'DM Sans', sans-serif; font-size: 0.92rem; font-weight: 500;
            padding: 12px 28px; border-radius: 100px;
            border: 1.5px solid var(--border); background: transparent;
            color: var(--navy); cursor: pointer;
            text-decoration: none; display: inline-block;
            transition: all 0.2s;
        }
        .btn-secondary:hover { border-color: var(--navy); transform: translateY(-1px); }

        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; font-size: 0.8rem; font-weight: 500; color: var(--navy); margin-bottom: 7px; letter-spacing: 0.02em; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%; padding: 12px 16px; border: 1.5px solid var(--border); border-radius: 10px;
            font-family: 'DM Sans', sans-serif; font-size: 0.9rem; background: var(--bg); color: var(--navy);
            outline: none; transition: border-color 0.18s, background 0.18s;
        }
        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--navy); background: var(--white); }
        .form-group textarea { resize: vertical; min-height: 90px; }

        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
        .form-grid.single { grid-template-columns: 1fr; }
        .form-actions { display: flex; gap: 12px; margin-top: 28px; justify-content: flex-end; }

        .progress-bar-wrap { height: 3px; background: var(--bg); border-radius: 99px; margin-top: 14px; }
        .progress-bar { height: 100%; border-radius: 99px; background: var(--teal); }

        .module-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; margin-bottom: 40px; }
        .module-card {
            background: var(--white); border: 1px solid var(--border); border-radius: var(--radius);
            padding: 22px 20px 18px; cursor: pointer; transition: all 0.2s; position: relative; overflow: hidden;
        }
        .module-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: var(--orange); transform: scaleX(0); transform-origin: left; transition: transform 0.2s;
        }
        .module-card:hover { transform: translateY(-2px); box-shadow: var(--card-shadow); border-color: transparent; }
        .module-card:hover::before { transform: scaleX(1); }
        .module-tag { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--orange); margin-bottom: 10px; }
        .module-card h4 { font-family: 'Syne', sans-serif; font-size: 0.95rem; font-weight: 700; color: var(--navy); line-height: 1.35; margin-bottom: 10px; }

        /* Validation */
        .field-validation-error { color: var(--orange); font-size: 0.78rem; display: block; margin-top: 4px; }
        .validation-summary-errors { background: #FFF0EC; border: 1px solid #FFCCC0; border-radius: 10px; padding: 12px 16px; margin-bottom: 18px; }
        .validation-summary-errors ul { padding-left: 18px; font-size: 0.83rem; color: var(--orange); }

        @media (max-width: 900px) {
            .dashboard-layout { grid-template-columns: 1fr; }
            .sidebar { display: none; }
            .main-content { padding: 28px 24px; }
            .stat-grid { grid-template-columns: repeat(2, 1fr); }
            .form-grid { grid-template-columns: 1fr; }
        }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>

<!-- TOP NAV -->
<nav class="topnav">
    <a class="logo" href="/Default.aspx">Oly<span>Math</span></a>
    <div class="nav-right">
        <asp:LoginView ID="LoginView1" runat="server">
            <RoleGroups>
                <asp:RoleGroup Roles="Admin">
                    <ContentTemplate>
                        <span class="nav-badge admin">Admin</span>
                    </ContentTemplate>
                </asp:RoleGroup>
                <asp:RoleGroup Roles="Trainer">
                    <ContentTemplate>
                        <span class="nav-badge trainer">Trainer</span>
                    </ContentTemplate>
                </asp:RoleGroup>
                <asp:RoleGroup Roles="Trainee">
                    <ContentTemplate>
                        <span class="nav-badge">Trainee</span>
                    </ContentTemplate>
                </asp:RoleGroup>
            </RoleGroups>
        </asp:LoginView>
        <a href="/Account/Logout.aspx" class="btn-logout">Sign Out</a>
    </div>
</nav>

<div class="page-body">
    <div class="dashboard-layout">

        <!-- SIDEBAR — role-based -->
        <aside class="sidebar">
            <asp:LoginView ID="SidebarLoginView" runat="server">
                <RoleGroups>

                    <asp:RoleGroup Roles="Admin">
                        <ContentTemplate>
                            <div class="sidebar-section">
                                <span class="sidebar-label">Admin</span>
                                <a href="/TrainerDashboard.aspx" class="sidebar-item<%=IsActive("/TrainerDashboard.aspx")%>">
                                    <span class="dot"></span> Dashboard
                                </a>
                                <a href="/AssessmentList.aspx" class="sidebar-item<%=IsActive("/AssessmentList.aspx")%>">
                                    <span class="dot"></span> Assessments
                                </a>
                                <a href="/CreateAssessment.aspx" class="sidebar-item<%=IsActive("/CreateAssessment.aspx")%>">
                                    <span class="dot"></span> Create Assessment
                                </a>
                                <a href="/QuestionList.aspx" class="sidebar-item<%=IsActive("/QuestionList.aspx")%>">
                                    <span class="dot"></span> Questions
                                </a>
                            </div>
                            <div class="sidebar-section" style="margin-top:16px">
                                <span class="sidebar-label">Community</span>
                                <a href="/Discussions.aspx" class="sidebar-item<%=IsActive("/Discussions.aspx")%>">
                                    <span class="dot"></span> Discussion Zone
                                </a>
                            </div>
                        </ContentTemplate>
                    </asp:RoleGroup>

                    <asp:RoleGroup Roles="Trainer">
                        <ContentTemplate>
                            <div class="sidebar-section">
                                <span class="sidebar-label">Trainer</span>
                                <a href="/TrainerDashboard.aspx" class="sidebar-item<%=IsActive("/TrainerDashboard.aspx")%>">
                                    <span class="dot"></span> Dashboard
                                </a>
                                <a href="/CreateAssessment.aspx" class="sidebar-item<%=IsActive("/CreateAssessment.aspx")%>">
                                    <span class="dot"></span> Create Assessment
                                </a>
                                <a href="/QuestionList.aspx" class="sidebar-item<%=IsActive("/QuestionList.aspx")%>">
                                    <span class="dot"></span> Questions
                                </a>
                            </div>
                            <div class="sidebar-section" style="margin-top:16px">
                                <span class="sidebar-label">Community</span>
                                <a href="/Discussions.aspx" class="sidebar-item<%=IsActive("/Discussions.aspx")%>">
                                    <span class="dot"></span> Discussion Zone
                                </a>
                            </div>
                        </ContentTemplate>
                    </asp:RoleGroup>

                    <asp:RoleGroup Roles="Trainee">
                        <ContentTemplate>
                            <div class="sidebar-section">
                                <span class="sidebar-label">Trainee</span>
                                <a href="/AssessmentList.aspx" class="sidebar-item<%=IsActive("/AssessmentList.aspx")%>">
                                    <span class="dot"></span> Assessments
                                </a>
                                <a href="/Trainee/ViewModule.aspx" class="sidebar-item<%=IsActive("/Trainee/ViewModule.aspx")%>">
                                    <span class="dot"></span> Modules
                                </a>
                                <a href="/Certificate.aspx" class="sidebar-item<%=IsActive("/Certificate.aspx")%>">
                                    <span class="dot"></span> Certificates
                                </a>
                            </div>
                            <div class="sidebar-section" style="margin-top:16px">
                                <span class="sidebar-label">Community</span>
                                <a href="/Discussions.aspx" class="sidebar-item<%=IsActive("/Discussions.aspx")%>">
                                    <span class="dot"></span> Discussion Zone
                                </a>
                            </div>
                        </ContentTemplate>
                    </asp:RoleGroup>

                </RoleGroups>
            </asp:LoginView>
            <asp:ContentPlaceHolder ID="SidebarContent" runat="server" />
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <form id="MainForm" runat="server"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></form>
        </main>

    </div>
</div>

</body>
</html>



