@model WAPP_Assignment_Module.Models.Chapter

@{
    ViewBag.Title = "Add Chapter";
}

<h2>Add Chapter to: @ViewBag.ModuleTitle</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.Hidden("ModuleId", (int)ViewBag.ModuleId)

        <div class="form-group">
            @Html.LabelFor(m => m.Title, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Title, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.ContentHtml, new { @class = "col-md-2 control-label" })
            <div class="col-md-10">
                @Html.TextAreaFor(m => m.ContentHtml, new { @class = "form-control", rows = "8" })
                @Html.ValidationMessageFor(m => m.ContentHtml, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <div class="checkbox">
                    @Html.CheckBoxFor(m => m.HasAssessment)
                    @Html.LabelFor(m => m.HasAssessment)
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Add Chapter" class="btn btn-success" />
                @Html.ActionLink("Cancel", "Index", new { moduleId = ViewBag.ModuleId }, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}