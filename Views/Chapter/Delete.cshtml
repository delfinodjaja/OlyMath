@model WAPP_Assignment_Module.Models.Chapter

@{
    ViewBag.Title = "Delete Chapter";
}

<h2>Delete Chapter</h2>
<h3>Are you sure you want to delete this chapter?</h3>

<table class="table">
    <tr><th>Title</th><td>@Model.Title</td></tr>
    <tr><th>Order</th><td>@Model.SequenceOrder</td></tr>
    <tr><th>Has Assessment</th><td>@(Model.HasAssessment ? "Yes" : "No")</td></tr>
    <tr><th>Created</th><td>@Model.CreatedAt.ToShortDateString()</td></tr>
</table>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Yes, Delete" class="btn btn-danger" />
    @Html.ActionLink("Cancel", "Index", new { moduleId = Model.ModuleId }, new { @class = "btn btn-default" })
}