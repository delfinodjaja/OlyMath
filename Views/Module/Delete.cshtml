@model WAPP_Assignment_Module.Models.OlyModule

@{
    ViewBag.Title = "Delete Module";
}

<h2>Delete Module</h2>
<h3>Are you sure you want to delete this module?</h3>

<table class="table">
    <tr><th>Title</th><td>@Model.Title</td></tr>
    <tr><th>Topic</th><td>@Model.TopicTag</td></tr>
    <tr><th>Difficulty</th><td>@Model.Difficulty</td></tr>
    <tr><th>Status</th><td>@Model.Status</td></tr>
</table>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Yes, Delete" class="btn btn-danger" />
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
}